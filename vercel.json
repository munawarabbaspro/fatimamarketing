{
 "$schema": "https://openapi.vercel.sh/vercel.json",
 "framework": null,
 "installCommand": "",
 "buildCommand": "node website/build.mjs",
 "outputDirectory": "website/dist",
 "cleanUrls": true,
 "trailingSlash": true,
 "redirects": [
  {
   "source": "/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "fgoc.pk"
    }
   ],
   "destination": "https://fatimamarketing.com/:path",
   "permanent": true
  },
  {
   "source": "/:path(.*)",
   "has": [
    {
     "type": "host",
     "value": "www.fgoc.pk"
    }
   ],
   "destination": "https://fatimamarketing.com/:path",
   "permanent": true
  },
  {
   "source": "/about-us/",
   "destination": "/about/",
   "permanent": true
  },
  {
   "source": "/fatima-marketing/",
   "destination": "/about/",
   "permanent": true
  },
  {
   "source": "/fatima-associates/",
   "destination": "/about/",
   "permanent": true
  },
  {
